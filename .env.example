# Kopiera till .env och fyll i. .env committas aldrig.

# Porten Express lyssnar på lokalt. Vercel sätter denna själv i produktion.
PORT=3000

# Anslutning till Postgres hos Supabase. Transaction pooler, port 6543.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Signerar admin-inloggningens sessionscookie. Valfri lång slumpad sträng.
SESSION_SECRET=

# Frankfurter, valutakurser från ECB. Ingen API-nyckel behövs.
CURRENCY_API_URL=https://api.frankfurter.dev/v1

# Cache-tid i sekunder för valutakurser. ECB uppdaterar kurserna en gång per dag.
CURRENCY_CACHE_SECONDS=300
